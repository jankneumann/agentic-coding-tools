{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archetypes Configuration",
  "description": "Schema for archetypes.yaml — named agent archetype definitions with model preference, system prompt, and optional complexity escalation rules. Mirrors the runtime ARCHETYPES_SCHEMA in agent-coordinator/src/agents_config.py (the source of truth); keep the two in sync.",
  "type": "object",
  "required": ["schema_version", "archetypes"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "Schema version. v1 = legacy; v2 enables phase_mapping; v3 adds model_aliases / tier models."
    },
    "local_host_class": {
      "type": ["object", "null"],
      "required": ["name", "active_params_ceiling_b"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "active_params_ceiling_b": {"type": "number", "exclusiveMinimum": 0},
        "dense_params_limit_b": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "model_aliases": {
      "type": ["object", "null"],
      "description": "Sole authored tier→model(+thinking) map per provider (schema_version 3).",
      "properties": {
        "local": {
          "type": "object",
          "required": ["standard", "economy"],
          "additionalProperties": false,
          "properties": {
            "frontier": {"$ref": "#/$defs/localTierEntry"},
            "premium": {"$ref": "#/$defs/localTierEntry"},
            "standard": {"$ref": "#/$defs/localTierEntry"},
            "economy": {"$ref": "#/$defs/localTierEntry"}
          }
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": ["premium", "standard", "economy"],
        "additionalProperties": false,
        "properties": {
          "frontier": {"$ref": "#/$defs/tierEntry"},
          "premium": {"$ref": "#/$defs/tierEntry"},
          "standard": {"$ref": "#/$defs/tierEntry"},
          "economy": {"$ref": "#/$defs/tierEntry"}
        }
      }
    },
    "archetypes": {
      "type": "object",
      "minProperties": 1,
      "description": "Map of archetype name to archetype configuration.",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$",
        "description": "Archetype names must be lowercase alphanumeric with hyphens/underscores, max 32 chars."
      },
      "additionalProperties": {
        "type": "object",
        "required": ["model", "system_prompt", "write_capable"],
        "properties": {
          "model": {
            "type": "string",
            "enum": ["frontier", "premium", "standard", "economy", "opus", "sonnet", "haiku"],
            "description": "Primary model tier for this archetype (or a legacy Claude alias)."
          },
          "system_prompt": {
            "type": "string",
            "description": "Role-specific instruction prefix composed with task prompts."
          },
          "write_capable": {
            "type": "boolean",
            "description": "Whether this archetype may write files/artifacts. Required on every archetype (no implicit default)."
          },
          "escalation": {
            "type": ["object", "null"],
            "description": "Optional complexity-based model escalation rules.",
            "properties": {
              "escalate_to": {
                "type": "string",
                "enum": ["frontier", "premium", "standard", "economy", "opus", "sonnet", "haiku"]
              },
              "max_write_dirs": {"type": "integer", "minimum": 1},
              "max_dependencies": {"type": "integer", "minimum": 1},
              "loc_threshold": {"type": "integer", "minimum": 1}
            },
            "required": ["escalate_to"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "phase_mapping": {
      "type": ["object", "null"],
      "description": "Optional per-phase archetype resolution (schema_version 2+).",
      "additionalProperties": {
        "type": "object",
        "required": ["archetype"],
        "additionalProperties": false,
        "properties": {
          "archetype": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "signals": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tierEntry": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "required": ["model"],
          "additionalProperties": false,
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "thinking": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "localTierEntry": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 128},
        "total_params_b": {"type": "number", "exclusiveMinimum": 0},
        "active_params_b": {"type": "number", "exclusiveMinimum": 0},
        "reviewed": {"type": "string", "minLength": 1}
      }
    }
  }
}
