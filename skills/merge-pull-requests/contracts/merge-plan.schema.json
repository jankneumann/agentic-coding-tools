{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools/contracts/merge-plan.schema.json",
  "title": "MergePlan",
  "description": "Durable merge plan emitted by the merge-pull-requests analysis round and consumed by plan-driven execution. Separates plan definition from live state. Schema 1.1 added kind, change_id, remediation_skill, ci_failure_class, and a plan-level compact resume pointer. Schema 1.2 adds state.review_waiver (the recorded policy or operator waiver of vendor review) and removes the former iterate-consensus path field from state; other versions are rejected and must be rebuilt by the analysis round.",
  "type": "object",
  "required": ["schema_version", "generated_at", "storage_tier", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "storage_tier": {"enum": ["file", "coordinator"]},
    "base_branch": {"type": "string", "default": "main"},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "last_merged_pr": {"type": ["integer", "null"], "minimum": 1},
    "compact_requested": {"type": "boolean", "default": false},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["pr", "origin", "strategy", "auto_executable", "definition", "state"],
      "additionalProperties": false,
      "properties": {
        "pr": {"type": "integer", "minimum": 1},
        "title": {"type": "string"},
        "origin": {
          "enum": ["openspec", "codex", "sentinel", "bolt", "palette", "jules", "dependabot", "renovate", "other"]
        },
        "strategy": {"enum": ["rebase", "squash", "merge"]},
        "auto_executable": {"type": "boolean"},
        "definition": {
          "type": "object",
          "required": ["depends_on", "gates", "kind", "remediation_skill"],
          "additionalProperties": false,
          "properties": {
            "depends_on": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "gates": {
              "type": "array",
              "items": {
                "enum": ["requires_human_approval", "admin_override_needed", "proposal_acceptance", "required_review"]
              }
            },
            "changed_files": {"type": "array", "items": {"type": "string"}},
            "inserted_reason": {"type": "string"},
            "kind": {"enum": ["plan", "implementation", "automation"]},
            "change_id": {"type": ["string", "null"]},
            "remediation_skill": {
              "enum": ["iterate-on-plan", "iterate-on-implementation", "quick-task", "none"]
            },
            "kind_overridden": {"type": "boolean", "default": false}
          }
        },
        "state": {
          "type": "object",
          "required": ["outcome", "staleness", "ci_state", "unresolved_comments"],
          "additionalProperties": false,
          "properties": {
            "outcome": {"enum": ["pending", "in_progress", "merged", "closed", "deferred", "failed"]},
            "needs_revalidation": {"type": "boolean", "default": false},
            "claimed_by": {"type": ["string", "null"]},
            "staleness": {"enum": ["fresh", "stale", "obsolete", "unknown"]},
            "ci_state": {"enum": ["clean", "unstable", "blocked", "dirty", "unknown"]},
            "ci_failure_class": {
              "type": ["string", "null"],
              "enum": ["transient", "pr_specific", "stale_base", null]
            },
            "unresolved_comments": {"type": "integer", "minimum": 0},
            "unresolved_comment_summary": {"type": ["string", "null"]},
            "vendor_verdict": {"type": ["object", "null"], "additionalProperties": true},
            "review_waiver": {
              "type": ["object", "null"],
              "required": ["reason", "source", "approver", "recorded_at", "eligibility_reason"],
              "additionalProperties": false,
              "properties": {
                "reason": {"type": "string", "minLength": 1},
                "source": {"enum": ["policy", "operator"]},
                "approver": {"type": "string", "minLength": 1},
                "recorded_at": {"type": "string", "format": "date-time"},
                "eligibility_reason": {"type": ["string", "null"]}
              }
            },
            "blocking_reason": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
