# Copy to .env.local and fill in real values. Vite reads .env.local at server
# start (npm run dev) — restart after changes. Never commit .env.local.

# Coordinator HTTP base URL. Use https://coord.rotkohl.ai for the hosted
# instance, or http://localhost:8000 for a locally-running coordinator.
VITE_COORDINATOR_URL=http://localhost:8000

# Bearer token sent on every coordinator request. 64-char API key issued
# by the coordinator (`setup-coordinator` skill or `coord-env` profile).
VITE_COORDINATOR_API_KEY=

# Optional: comma-separated change-id allow-list to filter the board.
# Leave empty to show all changes.
VITE_CHANGE_IDS=
