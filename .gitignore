# Per-run autopilot phase-resolution cache (wire-autopilot-phase-subagents D4)
openspec/changes/*/.phase-resolution-cache.json

# Coordinator task-status renderer stale-marker sidecar
# (contracts/README.md: "openspec/changes/<id>/.tasks-status.state.json (gitignored)")
openspec/changes/*/.tasks-status.state.json

# Transient curator scratch from /plan-roadmap structural pass (consumed by finalize)
openspec/.plan-roadmap-tmp/

# Legacy openspec init output (replaced by .agents/skills/ via skills/install.sh)
.agent/
skills/merge-pull-requests/scripts/docs/

# Generated skill mirrors — THIS REPO ONLY.
# .claude/skills/ and .agents/skills/ are rsync/symlink copies of the canonical
# skills/ tree, produced by skills/install.sh. Because canonical skills/ ships in
# this repo, the mirrors can always be regenerated on checkout, so tracking them
# only produces drift noise (e.g. cloud sessions committing /home/user/... symlinks
# that show as phantom "deleted" locally). Other repos that consume these skills
# WITHOUT a parallel checkout of this repo must still commit their mirrors.
.claude/skills/
.agents/skills/

# ri-07 project-context refresh manifest: a durable, machine-local projection of
# the refresh operation (embeds operation id + created-at). Kept out of the
# tracked tree so a repeat refresh at the same revision produces no repo diff.
.git-context/

# Scoped flow-validation output. The full-scope architecture.diagnostics.json is
# committed; scoped runs (validate-feature) write here so they cannot clobber it.
docs/architecture-analysis/architecture.diagnostics.scoped.json

# Local-cache architecture artifacts. These are generated analyzer caches with no
# consumer outside the refresh-architecture pipeline: nothing reads them but the
# next stage of the same run, and they churn ~2.76 MB of blob per refresh. The
# pipeline still writes them to disk, and provenance still records them with
# `tier: local-cache` and still verifies their digest when they are present — an
# absent local-cache artifact is simply not drift, so tracking them buys nothing.
docs/architecture-analysis/treesitter_enrichment.json
docs/architecture-analysis/python_analysis.json
docs/architecture-analysis/parallel_zones.json
# Rendered codebase atlas — derived from architecture.graph.json by `make atlas`.
# ~650 KB of generated HTML with an embedded JSON payload: regenerable in about a
# second, and not meaningfully diffable, so tracking it would only add noise.
docs/architecture-analysis/atlas/
