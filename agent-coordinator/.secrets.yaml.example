# .secrets.yaml — Local secrets for profile interpolation.
# Copy to .secrets.yaml and fill in real values.
# This file is gitignored — never commit the real .secrets.yaml.
#
# When OpenBao is enabled (BAO_ADDR set), secrets are loaded from OpenBao
# instead of this file. Use `make bao-seed` to populate OpenBao from this file.
#
# OpenBao environment variables (set these in .env or shell):
#   BAO_ADDR=http://localhost:8200    # OpenBao server URL (activates OpenBao backend)
#   BAO_ROLE_ID=<role-id>             # AppRole role ID for authentication
#   BAO_SECRET_ID=<secret-id>         # AppRole secret ID for authentication
#   BAO_MOUNT_PATH=secret             # KV v2 mount path (default: secret)
#   BAO_SECRET_PATH=coordinator       # Secret data path (default: coordinator)
#   BAO_TIMEOUT=5                     # Connection timeout in seconds (default: 5)
#   BAO_TOKEN_TTL=3600                # Token TTL in seconds (default: 3600)
#   BAO_TOKEN=<root-token>            # Root token for bao-seed.py only

DB_PASSWORD: postgres

# --- Coordinator API keys (one per harness) ---------------------------------
# These are the credentials agents present to the coordinator as X-API-Key —
# NOT vendor model keys. COORDINATION_API_KEYS and
# COORDINATION_API_KEY_IDENTITIES are auto-derived from the agents.yaml entries
# that interpolate these variables, so filling one in here is all that is
# needed to admit that harness; leaving one empty simply omits that agent from
# the key set. Generate values with `python3 scripts/setup_cloud.py --domain
# <host>` (which also writes the per-harness shell aliases) or
# `python3 -c "import secrets; print(secrets.token_hex(32))"`.
#
# Local harnesses need keys just as much as cloud ones: they authenticate over
# HTTP through the session hooks and, in a hosted-coordinator deployment, for
# every coordination call.
CLAUDE_LOCAL_API_KEY: ""      # claude-local
CODEX_LOCAL_API_KEY: ""       # codex-local
ANTIGRAVITY_LOCAL_API_KEY: "" # antigravity-local (agy)
GROK_LOCAL_API_KEY: ""        # grok-local
PI_LOCAL_API_KEY: ""          # pi-local
CLAUDE_WEB_API_KEY: ""        # claude-remote
CODEX_API_KEY: ""             # codex-remote
GROK_REMOTE_API_KEY: ""       # grok-remote

# --- Vendor model keys ------------------------------------------------------
# OpenRouter key — used by the `pi` harness to route the frontier model
# (moonshotai/kimi-k3) via `--provider openrouter`.
OPENROUTER_API_KEY: ""

# Langfuse (observability/tracing/prompt management).
# Consumed by:
#   - skills/langfuse/scripts/install_mcp.py (registers MCP server with all agents)
#   - agent-coordinator/scripts/langfuse_hook.py (Claude Code Stop hook → traces)
#   - npx langfuse-cli (terminal API access)
# Retrieve into shell with: eval "$(skills/bao-vault/scripts/langfuse_env.sh)"
LANGFUSE_PUBLIC_KEY: ""
LANGFUSE_SECRET_KEY: ""
LANGFUSE_HOST: "https://cloud.langfuse.com"
