{
  "autoCompactWindow": 200000,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)",
      "WebFetch(domain:*.railway.app)",
      "WebFetch(domain:*.up.railway.app)",
      "WebFetch(domain:rotkohl.ai)",
      "WebFetch(domain:*.rotkohl.ai)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:*.supabase.co)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push origin openspec/*)",
      "Bash(git push -u origin openspec/*)",
      "Bash(git push origin HEAD:openspec/*)",
      "Bash(git push -u origin HEAD:openspec/*)",
      "Bash(git push origin \"openspec/*\")",
      "Bash(git push -u origin \"openspec/*\")",
      "Bash(git push origin \"HEAD:openspec/*\")",
      "Bash(git push -u origin \"HEAD:openspec/*\")",
      "Bash(railway variable set:*)",
      "Bash(curl https://*.rotkohl.ai/*)",
      "Bash(curl * https://*.rotkohl.ai/*)",
      "Bash(git push -u origin claude/*)"
    ],
    "ask": [
      "Bash(alembic *)",
      "Bash(psql *)",
      "Bash(railway *)",
      "Bash(env *)",
      "Bash(git push *openspec/* *)",
      "Bash(git push *openspec/*:*)",
      "Bash(git push *$*)",
      "Bash(git push *`*)",
      "Bash(git push *openspec/roadmap-*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(**/.env.*)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(find * -delete*)",
      "Bash(gh repo delete *)",
      "Bash(gh pr merge --admin *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git push *",
      "git fetch *",
      "git pull *",
      "gh *",
      "railway *",
      "docker *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.cache/uv",
        "~/Library/Caches/uv",
        "~/.npm"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.kube",
        "~/.docker",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.claude/.credentials.json",
        "~/.codex",
        ".."
      ],
      "allowRead": [
        "."
      ]
    },
    "network": {
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "coord.rotkohl.ai"
      ],
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/bootstrap-cloud.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/print_coordinator_env.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/register_agent.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/irreversible_guard.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/report_status.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/check_compact.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/skills/langfuse/scripts/run_stop_hook.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/precompact_handoff.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/report_status.py --subagent"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/skills/session-bootstrap/scripts/hooks/deregister_agent.py"
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory"
}
