[Unit]
Description=GX-10 coordinator runtime secret rendering from the shared OpenBao
# OpenBao belongs to the analyzer's stack and must be running and unsealed.
Requires=aca-gx10-openbao-container.service
After=network-online.target aca-gx10-openbao-container.service
Before=aca-gx10-coordinator.service

[Service]
Type=oneshot
WorkingDirectory=/opt/agentic-coding-tools
EnvironmentFile=-/etc/aca/gx10-coordinator.env
Environment=GX10_RUNTIME_DIR=/run/aca/gx10
Environment=GX10_BAO_ADDR=http://10.89.0.250:8200/v1
LoadCredential=coord-role-id:/etc/aca/gx10/coordinator-role-id
LoadCredential=coord-secret-id:/etc/aca/gx10/coordinator-secret-id
ExecStartPre=/opt/agentic-coding-tools/deploy/gx10/openbao/login-coordinator-approle.sh
ExecStart=/opt/agentic-coding-tools/deploy/gx10/openbao/render-coordinator-secrets.sh
RemainAfterExit=yes
UMask=0077
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/aca/gx10
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
