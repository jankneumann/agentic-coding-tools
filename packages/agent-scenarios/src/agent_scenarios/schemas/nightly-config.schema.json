{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-scenarios/nightly-config.schema.json",
  "title": "agent-scenarios nightly config",
  "description": "Operator-authored config for `agent-scenarios nightly` (design D4). Paths may use ~ and are expanded at load.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarios_dir",
    "repo_root",
    "vendors",
    "vendor_commands"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "disable_file": {
      "type": [
        "string",
        "null"
      ],
      "default": "~/.config/agent-scenarios/DISABLED",
      "description": "Kill-file: when it exists the run behaves as disabled. null turns the kill-file off."
    },
    "scenarios_dir": {
      "type": "string"
    },
    "repo_root": {
      "type": "string"
    },
    "skills_root": {
      "type": [
        "string",
        "null"
      ],
      "default": "skills"
    },
    "vendors": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "vendor_commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "env_scrub": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Additional variables removed from the vendor subprocess environment. Always unioned with the built-in HERMETIC_SCRUB denylist (design D5) and with the variables named by gaps.api_key_env and gaps.coordinator_url_env; config can add to the denylist but never remove from it."
    },
    "env_set": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "propertyNames": {
        "not": {
          "enum": [
            "GH_TOKEN",
            "GITHUB_TOKEN",
            "GH_ENTERPRISE_TOKEN",
            "GITHUB_ENTERPRISE_TOKEN",
            "COORDINATION_API_URL",
            "COORDINATION_API_KEY",
            "COORDINATOR_API_KEY",
            "COORDINATOR_URL",
            "COORDINATOR_HTTP_URL",
            "AGENT_COORDINATOR_API_URL",
            "AGENT_COORDINATOR_HTTP_URL",
            "AGENT_COORDINATOR_REST_PORT",
            "CF_ACCESS_CLIENT_ID",
            "CF_ACCESS_CLIENT_SECRET"
          ]
        }
      },
      "description": "Extra overrides for the vendor subprocess environment. May not name a HERMETIC_SCRUB variable or COORDINATION_API_URL: the executor always forces COORDINATION_API_URL=http://127.0.0.1:9 after applying env_set, and a config that tries to set a denylisted name is schema-invalid (guard 0, exit 2)."
    },
    "workspaces_root": {
      "type": [
        "string",
        "null"
      ],
      "description": "Default <state>/workspaces."
    },
    "retain_failed_runs": {
      "type": "integer",
      "minimum": 0,
      "default": 7,
      "description": "Run directories holding kept fail/error workspaces beyond this many newest runs are deleted at run start."
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_pairs": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        },
        "max_pairs_per_vendor": {
          "type": "integer",
          "minimum": 1,
          "default": 15
        },
        "max_wall_clock_minutes": {
          "type": "integer",
          "minimum": 1,
          "default": 240
        },
        "per_pair_timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "default": 1200
        }
      },
      "default": {
        "max_pairs": 30,
        "max_pairs_per_vendor": 15,
        "max_wall_clock_minutes": 240,
        "per_pair_timeout_seconds": 1200
      },
      "description": "Every key is optional and takes its default; a config that omits caps runs under the defaults."
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "may contain {run_id}"
        }
      }
    },
    "gaps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "spool_path": {
          "type": "string"
        },
        "agent_id": {
          "type": "string",
          "default": "agent-scenarios-nightly"
        },
        "coordinator_url_env": {
          "type": "string",
          "default": "COORDINATION_API_URL"
        },
        "api_key_env": {
          "type": "string",
          "default": "COORDINATION_API_KEY"
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
