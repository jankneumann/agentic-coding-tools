{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jankneumann/agentic-coding-tools/main/packages/gen-eval/src/gen_eval/contracts/interface-descriptor.schema.json",
  "title": "gen-eval interface descriptor",
  "x-gen-eval-contract-version": "2",
  "$defs": {
    "AuthConfig": {
      "description": "Authentication configuration for a service.",
      "properties": {
        "type": {
          "default": "none",
          "enum": [
            "api_key",
            "bearer",
            "basic",
            "none"
          ],
          "title": "Type",
          "type": "string"
        },
        "header": {
          "default": "X-API-Key",
          "title": "Header",
          "type": "string"
        },
        "env_var": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Env Var"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "title": "AuthConfig",
      "type": "object"
    },
    "BudgetConfig": {
      "description": "Budget allocation percentages for a gen-eval run.",
      "properties": {
        "total_usd": {
          "default": 5.0,
          "title": "Total Usd",
          "type": "number"
        },
        "generation_pct": {
          "default": 0.4,
          "title": "Generation Pct",
          "type": "number"
        },
        "evaluation_pct": {
          "default": 0.6,
          "title": "Evaluation Pct",
          "type": "number"
        },
        "tier1_pct": {
          "default": 0.4,
          "title": "Tier1 Pct",
          "type": "number"
        },
        "tier2_pct": {
          "default": 0.35,
          "title": "Tier2 Pct",
          "type": "number"
        },
        "tier3_pct": {
          "default": 0.25,
          "title": "Tier3 Pct",
          "type": "number"
        }
      },
      "title": "BudgetConfig",
      "type": "object"
    },
    "CommandSpec": {
      "description": "Description of a single CLI command.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "subcommands": {
          "items": {
            "type": "string"
          },
          "title": "Subcommands",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "args_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Args Schema"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "CommandSpec",
      "type": "object"
    },
    "EndpointSpec": {
      "description": "Description of a single HTTP endpoint.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "method": {
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "auth_required": {
          "default": false,
          "title": "Auth Required",
          "type": "boolean"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "request_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Schema"
        },
        "response_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Schema"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "path"
      ],
      "title": "EndpointSpec",
      "type": "object"
    },
    "FileInterfaceMapping": {
      "description": "Maps source files to interface endpoints for change detection.",
      "properties": {
        "file_pattern": {
          "title": "File Pattern",
          "type": "string"
        },
        "interfaces": {
          "items": {
            "type": "string"
          },
          "title": "Interfaces",
          "type": "array"
        }
      },
      "required": [
        "file_pattern",
        "interfaces"
      ],
      "title": "FileInterfaceMapping",
      "type": "object"
    },
    "McpToolSpec": {
      "description": "Description of a single MCP tool.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "input_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Schema"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "McpToolSpec",
      "type": "object"
    },
    "ServiceSpec": {
      "description": "A single testable service within a project.\n\nA container of element specs describing one *surface* of a project, not the\nproject itself \u2014 the document describing the project is\n:class:`InterfaceDescriptor`. Hence the ``Spec`` suffix (see design D1).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "http",
            "mcp",
            "cli",
            "browser"
          ],
          "title": "Type",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "openapi_spec": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openapi Spec"
        },
        "auth": {
          "anyOf": [
            {
              "$ref": "#/$defs/AuthConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/EndpointSpec"
          },
          "title": "Endpoints",
          "type": "array"
        },
        "transport": {
          "anyOf": [
            {
              "enum": [
                "stdio",
                "sse"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport"
        },
        "mcp_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Url"
        },
        "tools_manifest": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools Manifest"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/McpToolSpec"
          },
          "title": "Tools",
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "cli_schema": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cli Schema"
        },
        "json_flag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Flag"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/CommandSpec"
          },
          "title": "Commands",
          "type": "array"
        },
        "launch_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Launch Url"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "ServiceSpec",
      "type": "object"
    },
    "StartupConfig": {
      "description": "How to start/stop services for evaluation.\n\nOptional on :class:`InterfaceDescriptor` \u2014 omit the whole block for\nprojects with nothing to start (a CLI-only surface, or services managed\nentirely out-of-band). See ``InterfaceDescriptor.startup``.\n\nSecurity: ``command``, ``teardown``, and ``seed_command`` are executed via\n``subprocess.run(..., shell=True)`` in the orchestrator.  Descriptor files\nmust come from trusted sources \u2014 never load an untrusted descriptor.",
      "properties": {
        "command": {
          "title": "Command",
          "type": "string"
        },
        "health_check": {
          "title": "Health Check",
          "type": "string"
        },
        "health_timeout_seconds": {
          "default": 60,
          "title": "Health Timeout Seconds",
          "type": "integer"
        },
        "health_retry_count": {
          "default": 5,
          "title": "Health Retry Count",
          "type": "integer"
        },
        "teardown": {
          "title": "Teardown",
          "type": "string"
        },
        "seed_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed Command"
        }
      },
      "required": [
        "command",
        "health_check",
        "teardown"
      ],
      "title": "StartupConfig",
      "type": "object"
    },
    "StateVerifier": {
      "description": "A state backend for verification (not interaction).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "postgres",
            "sqlite",
            "filesystem",
            "redis"
          ],
          "title": "Type",
          "type": "string"
        },
        "dsn_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dsn Env"
        },
        "tables": {
          "items": {
            "type": "string"
          },
          "title": "Tables",
          "type": "array"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "StateVerifier",
      "type": "object"
    }
  },
  "description": "Top-level project descriptor.\n\nDescribes an entire project's testable surface: services (HTTP, MCP, CLI),\nstate verifiers (databases), lifecycle configuration, and file-to-interface\nmappings for change detection.",
  "properties": {
    "project": {
      "title": "Project",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "services": {
      "items": {
        "$ref": "#/$defs/ServiceSpec"
      },
      "title": "Services",
      "type": "array"
    },
    "state_verifiers": {
      "items": {
        "$ref": "#/$defs/StateVerifier"
      },
      "title": "State Verifiers",
      "type": "array"
    },
    "startup": {
      "anyOf": [
        {
          "$ref": "#/$defs/StartupConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scenario_dirs": {
      "items": {
        "format": "path",
        "type": "string"
      },
      "title": "Scenario Dirs",
      "type": "array"
    },
    "budget_defaults": {
      "anyOf": [
        {
          "$ref": "#/$defs/BudgetConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "file_interface_map": {
      "items": {
        "$ref": "#/$defs/FileInterfaceMapping"
      },
      "title": "File Interface Map",
      "type": "array"
    }
  },
  "required": [
    "project",
    "version",
    "services"
  ],
  "type": "object"
}
