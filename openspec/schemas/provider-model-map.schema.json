{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/schemas/provider-model-map.schema.json",
  "title": "ProviderModelMap",
  "description": "Stable home for the provider model map contract. v2 adds the optional 'frontier' tier (providers MAY define it; resolution falls back to 'premium' when absent) and structured tier entries: a tier is either a bare model-id string or {model, thinking}, because thinking level is part of the model definition — tiers are tuned for cost per successful task, not cost per token. Tests must resolve this path, never a schema inside a change directory (change dirs move on archive).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "providers",
    "tiers"
  ],
  "$defs": {
    "tierEntry": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "model"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "thinking": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "frontier",
          "premium",
          "standard",
          "economy"
        ]
      },
      "uniqueItems": true
    },
    "providers": {
      "type": "object",
      "minProperties": 5,
      "required": [
        "claude_code",
        "codex",
        "antigravity",
        "grok",
        "pi"
      ],
      "propertyNames": {
        "enum": [
          "claude_code",
          "codex",
          "antigravity",
          "grok",
          "pi"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "premium",
          "standard",
          "economy"
        ],
        "properties": {
          "frontier": {
            "$ref": "#/$defs/tierEntry"
          },
          "premium": {
            "$ref": "#/$defs/tierEntry"
          },
          "standard": {
            "$ref": "#/$defs/tierEntry"
          },
          "economy": {
            "$ref": "#/$defs/tierEntry"
          }
        }
      }
    }
  }
}
