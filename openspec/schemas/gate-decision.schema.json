{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools/openspec/changes/encode-autopilot-gates-and-goal-gate-in-code/contracts/events/gate-decision.schema.json",
  "title": "GateDecisionRecord",
  "description": "One entry of LoopState.gate_decisions (autopilot) or Checkpoint.gate_decisions (autopilot-roadmap). Superset of ApprovalDecision.to_audit_record().",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "gate",
    "outcome",
    "resolution",
    "disposition",
    "reason",
    "posture_present",
    "recorded_at"
  ],
  "properties": {
    "gate": {
      "type": "string",
      "enum": [
        "gatekeeper_escalation",
        "proposal_approval",
        "plan_review_convergence_failure",
        "validation_failure",
        "escalate_resume",
        "replan_required",
        "pr_creation",
        "merge",
        "roadmap_approval"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "proceed",
        "blocked"
      ]
    },
    "resolution": {
      "type": "string",
      "enum": [
        "auto",
        "approved",
        "rejected",
        "timeout_default_proceed",
        "timeout_default_block",
        "posture_block",
        "coordinator_unreachable",
        "console_approved",
        "console_rejected"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "auto",
        "notify_with_timeout",
        "block"
      ]
    },
    "reason": {
      "type": "string"
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "default_action": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "proceed",
        "block",
        null
      ]
    },
    "posture_present": {
      "type": "boolean"
    },
    "phase": {
      "type": "string"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "description": "Operator note supplied to `gate-answer --note`."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_id": {
      "type": "string",
      "description": "uuid4 identifying this record; `approval_ref` is `gate-decision:<decision_id>`."
    },
    "source": {
      "type": "string",
      "description": "Who/what produced this record, e.g. `supervise`."
    },
    "verb": {
      "type": "string",
      "enum": [
        "cycle",
        "execute",
        "resume"
      ],
      "description": "The supervise verb in effect when the router evaluated this gate."
    },
    "roadmap_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "change_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "dispatch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "item_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "notified": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether push_notification's return value reported delivery when this approval was filed; stamped whenever an approval is filed."
    },
    "roadmap_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "description": "sha256 of the roadmap's authorized DAG shape; stamped on every roadmap_approval record."
    },
    "timeout_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "description": "The posture's notify_with_timeout window in effect when this decision was made, when approval_id is set; used to compute a pending-gate deadline for a filed approval (requested_at + timeout_seconds)."
    }
  }
}
