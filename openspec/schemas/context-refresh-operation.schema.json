{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/schemas/context-refresh-operation.schema.json",
  "title": "Project Context Refresh Operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "repository_id",
    "source_revision",
    "state",
    "record_revision",
    "attempt",
    "created_at",
    "updated_at",
    "producer_results",
    "semantic_index",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^pcr-[0-9a-f]{24}$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_revision": {
      "$ref": "./context-refresh-types.schema.json#/$defs/GitRevision"
    },
    "state": {
      "type": "string",
      "enum": ["pending", "running", "succeeded", "degraded", "failed"]
    },
    "record_revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_results": {
      "type": "array",
      "items": {
        "$ref": "./context-refresh-types.schema.json#/$defs/ProducerResult"
      }
    },
    "semantic_index": {
      "$ref": "./context-refresh-types.schema.json#/$defs/SemanticIndexReference"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "sha256"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["absent", "written", "validated"]
        },
        "path": {
          "oneOf": [
            {
              "$ref": "./context-refresh-types.schema.json#/$defs/RepositoryPath"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "./context-refresh-types.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "absent"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path": {
                "type": "null"
              },
              "sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "path": {
                "$ref": "./context-refresh-types.schema.json#/$defs/RepositoryPath"
              },
              "sha256": {
                "$ref": "./context-refresh-types.schema.json#/$defs/Sha256"
              }
            }
          }
        }
      ]
    },
    "error": {
      "$ref": "./context-refresh-types.schema.json#/$defs/SafeError"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["error"]
      }
    }
  ]
}
