{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/schemas/context-refresh-types.schema.json",
  "title": "Project Context Refresh Shared Types",
  "$defs": {
    "GitRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "RepositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "documentation": {
          "type": "string",
          "format": "uri-reference",
          "maxLength": 512
        }
      }
    },
    "Fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exact-search",
            "direct-source",
            "retry",
            "skip",
            "custom"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "ValidationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_id", "status", "summary"],
      "properties": {
        "validation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "RepositoryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/RepositoryPath"
        },
        "change": {
          "type": "string",
          "enum": ["added", "modified", "deleted"]
        },
        "sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "change": {
                "const": "deleted"
              }
            },
            "required": ["change"]
          },
          "then": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "sha256": {
                "$ref": "#/$defs/Sha256"
              }
            }
          }
        }
      ]
    },
    "SafeError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_class", "summary"],
      "properties": {
        "error_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "ProducerResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "producer_version",
        "status",
        "artifacts",
        "validations",
        "remediation"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "producer_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["fresh", "degraded", "failed", "not-configured"]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepositoryArtifact"
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ValidationResult"
          }
        },
        "remediation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Remediation"
          }
        },
        "fallback": {
          "$ref": "#/$defs/Fallback"
        },
        "error": {
          "$ref": "#/$defs/SafeError"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "not": {
                  "const": "fresh"
                }
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "remediation": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["degraded", "not-configured"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["fallback"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["error"]
          }
        }
      ]
    },
    "SemanticIndexReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requested_revision",
        "operation_id",
        "registry_record_id",
        "indexed_revision"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-configured",
            "pending",
            "running",
            "succeeded",
            "failed",
            "stale"
          ]
        },
        "requested_revision": {
          "$ref": "#/$defs/GitRevision"
        },
        "operation_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "registry_record_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 256
        },
        "indexed_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/GitRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback": {
          "$ref": "#/$defs/Fallback"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "operation_id": {
                "type": "string",
                "minLength": 1
              },
              "registry_record_id": {
                "type": "string",
                "minLength": 1
              },
              "indexed_revision": {
                "$ref": "#/$defs/GitRevision"
              }
            }
          },
          "else": {
            "required": ["fallback"]
          }
        }
      ]
    }
  }
}
