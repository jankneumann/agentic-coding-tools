{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/contracts/provider-model-map.schema.json",
  "title": "ProviderModelMap",
  "description": "Provider tier-to-model mapping. Schema version 2 closes the open provider key set: only roster members are accepted, so a retired harness cannot be reintroduced by config alone. The optional 'frontier' tier (per add-frontier-model-tier) is preserved: providers MAY define it; resolution falls back to premium when absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "providers",
    "tiers"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "tiers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "frontier",
          "premium",
          "standard",
          "economy"
        ]
      },
      "uniqueItems": true
    },
    "providers": {
      "type": "object",
      "description": "Keyed by canonical provider key. `antigravity` is the canonical key for the agy CLI (proposal D3); `agy` is not a valid key. `gemini` is retired and rejected. The full roster is REQUIRED, not merely permitted: `configuration`'s Provider Model Mapping requirement says the default map SHALL include all five, so a map carrying only a subset must fail validation (PLAN_REVIEW finding U3).",
      "required": [
        "claude_code",
        "codex",
        "antigravity",
        "grok",
        "pi"
      ],
      "propertyNames": {
        "enum": [
          "claude_code",
          "codex",
          "antigravity",
          "grok",
          "pi"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "premium",
          "standard",
          "economy"
        ],
        "properties": {
          "frontier": {
            "type": "string",
            "minLength": 1
          },
          "premium": {
            "type": "string",
            "minLength": 1
          },
          "standard": {
            "type": "string",
            "minLength": 1
          },
          "economy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 2,
      "tiers": [
        "frontier",
        "premium",
        "standard",
        "economy"
      ],
      "providers": {
        "claude_code": {
          "frontier": "fable",
          "premium": "opus",
          "standard": "sonnet",
          "economy": "haiku"
        },
        "codex": {
          "frontier": "gpt-5.6-sol",
          "premium": "gpt-5.5",
          "standard": "gpt-5.4",
          "economy": "gpt-5.4-mini"
        },
        "antigravity": {
          "premium": "<resolved by task 2.1>",
          "standard": "<resolved by task 2.1>",
          "economy": "<resolved by task 2.1>"
        },
        "grok": {
          "premium": "<resolved by task 2.6>",
          "standard": "<resolved by task 2.6>",
          "economy": "<resolved by task 2.6>"
        },
        "pi": {
          "premium": "qwen/qwen3-coder",
          "standard": "qwen/qwen3-coder",
          "economy": "qwen/qwen3-coder"
        }
      }
    }
  ]
}
