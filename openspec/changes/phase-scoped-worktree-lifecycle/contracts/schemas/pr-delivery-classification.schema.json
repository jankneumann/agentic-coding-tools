{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools/openspec/contracts/merge-pull-requests/pr-delivery-classification.schema.json",
  "title": "OpenSpec PR Delivery Classification",
  "description": "Deterministic, evidence-bearing classification of an OpenSpec pull request. Metadata corroborates but never overrides complete changed-file and base/head proposal evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_version",
    "pr_number",
    "base_branch",
    "base_sha",
    "head_sha",
    "change_id",
    "origin",
    "github_author",
    "author_vendor",
    "author_vendor_evidence",
    "delivery_stage",
    "marker_status",
    "evidence",
    "warnings",
    "ambiguity_reasons",
    "classified_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "ruleset_version": { "type": "string", "minLength": 1 },
    "pr_number": { "type": "integer", "minimum": 1 },
    "base_branch": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "minLength": 7 },
    "head_sha": { "type": "string", "minLength": 7 },
    "change_id": { "type": ["string", "null"], "minLength": 1 },
    "origin": {
      "enum": ["openspec", "codex", "sentinel", "bolt", "palette", "jules", "dependabot", "renovate", "other"]
    },
    "github_author": { "type": ["string", "null"], "minLength": 1 },
    "author_vendor": {
      "description": "Verified vendor or the literal unknown; independent from origin and delivery stage.",
      "type": "string",
      "minLength": 1
    },
    "author_vendor_evidence": { "$ref": "#/$defs/authorVendorEvidence" },
    "delivery_stage": { "$ref": "#/$defs/deliveryStage" },
    "marker_status": {
      "enum": ["missing", "matching", "conflicting", "duplicate", "invalid"]
    },
    "evidence": { "$ref": "#/$defs/evidence" },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "ambiguity_reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "classified_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "delivery_stage": { "const": "ambiguous" } },
        "required": ["delivery_stage"]
      },
      "then": {
        "properties": { "ambiguity_reasons": { "minItems": 1 } }
      },
      "else": {
        "properties": { "ambiguity_reasons": { "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": { "marker_status": { "enum": ["conflicting", "duplicate", "invalid"] } },
        "required": ["marker_status"]
      },
      "then": {
        "properties": { "delivery_stage": { "const": "ambiguous" } }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "diff_status": { "enum": ["truncated", "failed"] }
            },
            "required": ["diff_status"]
          }
        },
        "required": ["evidence"]
      },
      "then": {
        "properties": { "delivery_stage": { "const": "ambiguous" } }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "anyOf": [
              {
                "properties": {
                  "base_state": {
                    "properties": { "inspection_status": { "const": "failed" } },
                    "required": ["inspection_status"]
                  }
                },
                "required": ["base_state"]
              },
              {
                "properties": {
                  "head_state": {
                    "properties": { "inspection_status": { "const": "failed" } },
                    "required": ["inspection_status"]
                  }
                },
                "required": ["head_state"]
              }
            ]
          }
        },
        "required": ["evidence"]
      },
      "then": {
        "properties": { "delivery_stage": { "const": "ambiguous" } }
      }
    }
  ],
  "$defs": {
    "deliveryStage": {
      "enum": ["proposal", "implementation", "mixed", "ambiguous"]
    },
    "stageHint": {
      "oneOf": [
        { "enum": ["proposal", "implementation", "mixed"] },
        { "type": "null" }
      ]
    },
    "pathList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorVendorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_mapping", "claimed_vendor", "corroborating_hints", "verification_status", "conflicts"],
      "properties": {
        "identity_mapping": { "type": ["string", "null"], "minLength": 1 },
        "claimed_vendor": { "type": ["string", "null"], "minLength": 1 },
        "corroborating_hints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification_status": { "enum": ["verified", "claimed", "unknown", "conflicting"] },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diff_status",
        "changed_files",
        "planning_artifacts",
        "implementation_files",
        "other_files",
        "base_state",
        "head_state",
        "body_marker",
        "branch_hint",
        "marker_matches_classification"
      ],
      "properties": {
        "diff_status": { "enum": ["complete", "truncated", "failed"] },
        "changed_files": { "$ref": "#/$defs/pathList" },
        "planning_artifacts": { "$ref": "#/$defs/pathList" },
        "implementation_files": { "$ref": "#/$defs/pathList" },
        "other_files": { "$ref": "#/$defs/pathList" },
        "base_state": { "$ref": "#/$defs/proposalState" },
        "head_state": { "$ref": "#/$defs/proposalState" },
        "body_marker": {
          "description": "Single parsed OpenSpec-Delivery value when marker_status is missing or valid; otherwise null.",
          "$ref": "#/$defs/stageHint"
        },
        "branch_hint": {
          "description": "Non-authoritative stage inferred from branch naming, if any.",
          "$ref": "#/$defs/stageHint"
        },
        "marker_matches_classification": {
          "description": "Null when the marker is missing/invalid or primary classification is ambiguous for another reason.",
          "type": ["boolean", "null"]
        }
      }
    },
    "proposalState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspection_status",
        "change_path_exists",
        "proposal_present",
        "specs_present",
        "tasks_present",
        "implementation_state"
      ],
      "properties": {
        "inspection_status": { "enum": ["complete", "failed"] },
        "change_path_exists": { "type": "boolean" },
        "proposal_present": { "type": "boolean" },
        "specs_present": { "type": "boolean" },
        "tasks_present": { "type": "boolean" },
        "implementation_state": {
          "enum": ["absent", "planned", "in_progress", "complete", "unknown"]
        }
      }
    }
  }
}
