{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools/openspec/contracts/worktree/worktree-registry-v2.schema.json",
  "title": "Worktree Registry v2 Read Contract",
  "description": "Repository-owned worktree registry. Writers emit schema v2; readers also accept the legacy v1 shape for migration.",
  "oneOf": [
    { "$ref": "#/$defs/registryV2" },
    { "$ref": "#/$defs/registryV1" }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "activityLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "lease_id",
        "controller_instance_id",
        "session_id",
        "phase",
        "reason",
        "lifecycle_mode",
        "acquired_at",
        "last_heartbeat",
        "expires_at",
        "ttl_seconds"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Stable owner token, for example autopilot:<run-id> or phase:<PHASE>:<run-id>."
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "description": "Single-acquisition fencing token. Replacement after expiry MUST use a different value."
        },
        "controller_instance_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Per-controller process identity. Required for automatic leases; null is accepted only for normalized legacy manual leases."
        },
        "session_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Exact session identity used only by release-session; null is never a wildcard."
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "description": "Current write-capable phase. Kept extensible for future skills."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_mode": {
          "enum": ["standalone", "continuous", "manual"]
        },
        "acquired_at": { "$ref": "#/$defs/timestamp" },
        "last_heartbeat": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "default": 1800
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "lifecycle_mode": { "enum": ["standalone", "continuous"] } },
            "required": ["lifecycle_mode"]
          },
          "then": {
            "properties": { "controller_instance_id": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "leaseIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "lease_id",
        "controller_instance_id",
        "session_id",
        "phase",
        "reason",
        "lifecycle_mode",
        "ttl_seconds"
      ],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "minLength": 1 },
        "controller_instance_id": { "type": "string", "minLength": 1 },
        "session_id": { "type": ["string", "null"], "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "lifecycle_mode": { "enum": ["standalone", "continuous"] },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "default": 1800
        }
      },
      "description": "Requested initial ownership without lease timestamps. It grants no activity; acquired_at, last_heartbeat, and expires_at are created from one publication timestamp in the final reservation-to-entry transaction."
    },
    "durabilityTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_name", "remote_url_hash_algorithm", "canonical_remote_url_sha256", "ref_name"],
      "properties": {
        "remote_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "remote_url_hash_algorithm": { "const": "git-remote-url-v1" },
        "canonical_remote_url_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Digest of the currently configured remote URL after the contract's credential-stripping canonicalization."
        },
        "ref_name": {
          "type": "string",
          "pattern": "^refs/remotes/[A-Za-z0-9][A-Za-z0-9._-]*/.+",
          "description": "Remote-tracking ref whose remote component MUST equal remote_name; producers enforce this cross-field invariant."
        }
      }
    },
    "recoveryAuditTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event",
        "recorded_at",
        "change_id",
        "agent_id",
        "entry_generation",
        "actor",
        "rationale",
        "prior_owner",
        "prior_lease_id",
        "prior_controller_instance_id",
        "new_owner",
        "new_lease_id",
        "new_controller_instance_id",
        "process_evidence_key",
        "established_durability_target",
        "termination_confirmed"
      ],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "event": { "const": "force-adopted" },
        "recorded_at": { "$ref": "#/$defs/timestamp" },
        "change_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": ["string", "null"], "minLength": 1 },
        "entry_generation": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "prior_owner": { "type": ["string", "null"], "minLength": 1 },
        "prior_lease_id": { "type": ["string", "null"], "minLength": 1 },
        "prior_controller_instance_id": { "type": ["string", "null"], "minLength": 1 },
        "new_owner": { "type": "string", "minLength": 1 },
        "new_lease_id": { "type": "string", "minLength": 1 },
        "new_controller_instance_id": { "type": "string", "minLength": 1 },
        "process_evidence_key": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "established_durability_target": {
          "oneOf": [
            { "$ref": "#/$defs/durabilityTarget" },
            { "type": "null" }
          ],
          "description": "Target established by this force-adopt transition, or null when the entry already had a non-null target."
        },
        "termination_confirmed": { "type": "boolean" }
      },
      "allOf": [{ "properties": { "termination_confirmed": { "const": true } } }]
    },
    "recoveryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "prior_owner",
        "prior_lease_id",
        "prior_controller_instance_id",
        "process_evidence_key",
        "quarantined_at"
      ],
      "properties": {
        "source": { "enum": ["expired-takeover", "explicit-release", "owner-release", "session-release", "unsafe-finalization", "legacy-adoption", "setup-failure"] },
        "prior_owner": { "type": ["string", "null"], "minLength": 1 },
        "prior_lease_id": { "type": ["string", "null"], "minLength": 1 },
        "prior_controller_instance_id": { "type": ["string", "null"], "minLength": 1 },
        "process_evidence_key": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "quarantined_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "entryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "agent_id",
        "branch",
        "worktree_path",
        "created_at",
        "entry_generation",
        "durability_target",
        "retained",
        "retention_reason",
        "recovery_required",
        "recovery_reason",
        "recovery_context",
        "activity_lease"
      ],
      "properties": {
        "change_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": ["string", "null"], "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "worktree_path": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "entry_generation": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque generation changed whenever setup recreates an entry; used to revalidate observations made outside the registry lock."
        },
        "durability_target": {
          "oneOf": [
            { "$ref": "#/$defs/durabilityTarget" },
            { "type": "null" }
          ],
          "description": "Exact remote/ref that must contain HEAD before takeover or disposal. Package entries target the parent feature ref."
        },
        "last_heartbeat": {
          "oneOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ],
          "description": "Optional compatibility timestamp for general worktree use. Activity is determined from activity_lease, not this field."
        },
        "retained": {
          "type": "boolean",
          "description": "GC protection only; never evidence of an active writer."
        },
        "retention_reason": { "type": ["string", "null"], "minLength": 1 },
        "recovery_required": {
          "type": "boolean",
          "description": "True when dirty or non-durable state requires explicit operator adoption."
        },
        "recovery_reason": { "type": ["string", "null"], "minLength": 1 },
        "recovery_context": {
          "oneOf": [
            { "$ref": "#/$defs/recoveryContext" },
            { "type": "null" }
          ]
        },
        "activity_lease": {
          "oneOf": [
            { "$ref": "#/$defs/activityLease" },
            { "type": "null" }
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Unknown legacy entry fields preserved during v1-to-v2 normalization."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "retained": { "const": true } },
            "required": ["retained"]
          },
          "then": {
            "properties": { "retention_reason": { "type": "string", "minLength": 1 } }
          },
          "else": {
            "properties": { "retention_reason": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "recovery_required": { "const": true } },
            "required": ["recovery_required"]
          },
          "then": {
            "properties": {
              "recovery_reason": { "type": "string", "minLength": 1 },
              "recovery_context": { "$ref": "#/$defs/recoveryContext" }
            }
          },
          "else": {
            "properties": {
              "recovery_reason": { "type": "null" },
              "recovery_context": { "type": "null" }
            }
          }
        }
      ]
    },
    "setupReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_id",
        "change_id",
        "agent_id",
        "branch",
        "worktree_path",
        "entry_generation",
        "durability_target",
        "lease_intent",
        "state",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "setup_id": { "type": "string", "minLength": 1 },
        "change_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": ["string", "null"], "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "worktree_path": { "type": "string", "minLength": 1 },
        "entry_generation": { "type": "string", "minLength": 1 },
        "durability_target": { "$ref": "#/$defs/durabilityTarget" },
        "lease_intent": { "$ref": "#/$defs/leaseIntent" },
        "state": { "enum": ["reserved", "checkout-created", "evidence-created"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "description": "Non-active setup-and-acquire intent. Its lease_intent has no activity timestamps, is never interpreted as a writable entry, and is reconciled by exact generation before retry."
    },
    "registryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "entries", "setup_reservations", "recovery_audit"],
      "properties": {
        "schema_version": { "type": "integer", "const": 2 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryV2" }
        },
        "setup_reservations": {
          "type": "array",
          "items": { "$ref": "#/$defs/setupReservation" },
          "description": "Crash-recoverable setup-and-acquire operations; reservations never grant activity or satisfy ownership assertions."
        },
        "recovery_audit": {
          "type": "array",
          "items": { "$ref": "#/$defs/recoveryAuditTransition" },
          "description": "Append-only force-adoption safety history. Producer enforces unique event ids and preserves events after entry removal."
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true,
          "description": "Unknown legacy top-level fields preserved during v1-to-v2 normalization."
        }
      }
    },
    "entryV1": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "change_id",
        "branch",
        "worktree_path",
        "created_at",
        "pinned"
      ],
      "properties": {
        "change_id": { "type": "string", "minLength": 1 },
        "agent_id": { "type": ["string", "null"], "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "worktree_path": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "last_heartbeat": {
          "type": ["string", "null"],
          "description": "Legacy compatibility input; absent, null, or unparsable values normalize as non-active with diagnostics."
        },
        "pinned": { "type": "boolean" }
      }
    },
    "registryV1": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "entries"],
      "properties": {
        "version": { "type": "integer", "const": 1 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryV1" }
        }
      },
      "not": { "required": ["schema_version"] }
    }
  }
}
