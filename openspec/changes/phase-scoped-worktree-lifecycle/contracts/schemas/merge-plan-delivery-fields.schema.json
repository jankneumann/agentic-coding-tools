{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools/openspec/contracts/merge-pull-requests/merge-plan-delivery-fields.schema.json",
  "title": "Merge Plan Delivery Fields",
  "description": "Extracted view of the delivery-stage fields added to a durable merge-plan node. Definition is immutable evidence; state is the effective routing decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["definition", "state"],
  "properties": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_classification"],
      "properties": {
        "delivery_classification": {
          "$ref": "pr-delivery-classification.schema.json"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latest_delivery_classification", "delivery_routing", "operator_override_history"],
      "properties": {
        "latest_delivery_classification": {
          "$ref": "pr-delivery-classification.schema.json"
        },
        "delivery_routing": { "$ref": "#/$defs/deliveryRouting" },
        "operator_override_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/operatorOverrideEvent" },
          "description": "Append-only audit of override recording, execution, and invalidation."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "latest_delivery_classification": {
                "properties": { "delivery_stage": { "const": "ambiguous" } },
                "required": ["delivery_stage"]
              }
            },
            "required": ["latest_delivery_classification"]
          },
          "then": {
            "properties": {
              "delivery_routing": {
                "oneOf": [
                  {
                    "properties": {
                      "decision_source": { "const": "classifier" },
                      "effective_stage": { "const": "ambiguous" },
                      "operator_override": { "type": "null" }
                    }
                  },
                  {
                    "properties": {
                      "decision_source": { "const": "operator_override" },
                      "effective_stage": { "enum": ["proposal", "implementation", "mixed"] },
                      "operator_override": { "$ref": "#/$defs/operatorOverride" }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "delivery_routing": {
                "properties": {
                  "decision_source": { "const": "classifier" },
                  "operator_override": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "latest_delivery_classification": {
                "properties": { "delivery_stage": { "const": "proposal" } },
                "required": ["delivery_stage"]
              }
            }
          },
          "then": { "properties": { "delivery_routing": { "properties": { "effective_stage": { "const": "proposal" } } } } }
        },
        {
          "if": {
            "properties": {
              "latest_delivery_classification": {
                "properties": { "delivery_stage": { "const": "implementation" } },
                "required": ["delivery_stage"]
              }
            }
          },
          "then": { "properties": { "delivery_routing": { "properties": { "effective_stage": { "const": "implementation" } } } } }
        },
        {
          "if": {
            "properties": {
              "latest_delivery_classification": {
                "properties": { "delivery_stage": { "const": "mixed" } },
                "required": ["delivery_stage"]
              }
            }
          },
          "then": {
            "properties": {
              "delivery_routing": {
                "properties": { "effective_stage": { "const": "mixed" } }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "operatorOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "selected_stage",
        "reason",
        "recorded_at",
        "base_sha",
        "head_sha",
        "ruleset_version",
        "classification_digest_algorithm",
        "classification_digest"
      ],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "selected_stage": { "enum": ["proposal", "implementation", "mixed"] },
        "reason": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "string", "format": "date-time" },
        "base_sha": { "type": "string", "minLength": 7 },
        "head_sha": { "type": "string", "minLength": 7 },
        "ruleset_version": { "type": "string", "minLength": 1 },
        "classification_digest_algorithm": { "const": "pr-delivery-v1+jcs-sha256" },
        "classification_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the canonical latest delivery classification inspected by the operator."
        }
      }
    },
    "operatorOverrideEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id", "event_type", "occurred_at", "recorded_by", "override",
        "observed_delivery_stage", "observed_base_sha", "observed_head_sha",
        "observed_ruleset_version", "observed_classification_digest_algorithm",
        "observed_classification_digest", "reason_code"
      ],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "event_type": { "enum": ["recorded", "honored", "invalidated"] },
        "occurred_at": { "type": "string", "format": "date-time" },
        "recorded_by": { "type": "string", "minLength": 1 },
        "override": { "$ref": "#/$defs/operatorOverride" },
        "observed_delivery_stage": { "enum": ["proposal", "implementation", "mixed", "ambiguous"] },
        "observed_base_sha": { "type": "string", "minLength": 7 },
        "observed_head_sha": { "type": "string", "minLength": 7 },
        "observed_ruleset_version": { "type": "string", "minLength": 1 },
        "observed_classification_digest_algorithm": { "const": "pr-delivery-v1+jcs-sha256" },
        "observed_classification_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reason_code": {
          "enum": [
            "operator_recorded", "honored_at_execution", "base_sha_changed",
            "head_sha_changed", "ruleset_changed", "digest_changed",
            "classification_became_clear", "superseded"
          ]
        }
      }
    },
    "deliveryRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effective_stage",
        "decision_source",
        "review_context",
        "validation_route",
        "cleanup_route",
        "operator_override",
        "evaluated_at"
      ],
      "properties": {
        "effective_stage": {
          "enum": ["proposal", "implementation", "mixed", "ambiguous"]
        },
        "decision_source": { "enum": ["classifier", "operator_override"] },
        "review_context": {
          "enum": ["planning_only", "planning_and_code", "classification_only"]
        },
        "validation_route": { "enum": ["openspec_only", "full", "blocked"] },
        "cleanup_route": {
          "enum": ["preserve_active_change", "archive_after_merge", "blocked"]
        },
        "operator_override": {
          "oneOf": [
            { "$ref": "#/$defs/operatorOverride" },
            { "type": "null" }
          ]
        },
        "blocking_reason": { "type": ["string", "null"], "minLength": 1 },
        "evaluated_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision_source": { "const": "operator_override" } },
            "required": ["decision_source"]
          },
          "then": {
            "properties": { "operator_override": { "$ref": "#/$defs/operatorOverride" } }
          },
          "else": {
            "properties": { "operator_override": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": {
              "decision_source": { "const": "operator_override" },
              "effective_stage": { "const": "proposal" }
            },
            "required": ["decision_source", "effective_stage"]
          },
          "then": {
            "properties": {
              "operator_override": {
                "properties": { "selected_stage": { "const": "proposal" } },
                "required": ["selected_stage"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_source": { "const": "operator_override" },
              "effective_stage": { "const": "implementation" }
            },
            "required": ["decision_source", "effective_stage"]
          },
          "then": {
            "properties": {
              "operator_override": {
                "properties": { "selected_stage": { "const": "implementation" } },
                "required": ["selected_stage"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision_source": { "const": "operator_override" },
              "effective_stage": { "const": "mixed" }
            },
            "required": ["decision_source", "effective_stage"]
          },
          "then": {
            "properties": {
              "operator_override": {
                "properties": { "selected_stage": { "const": "mixed" } },
                "required": ["selected_stage"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "effective_stage": { "const": "proposal" } },
            "required": ["effective_stage"]
          },
          "then": {
            "properties": {
              "review_context": { "const": "planning_only" },
              "validation_route": { "const": "openspec_only" },
              "cleanup_route": { "const": "preserve_active_change" },
              "blocking_reason": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "effective_stage": { "enum": ["implementation", "mixed"] } },
            "required": ["effective_stage"]
          },
          "then": {
            "properties": {
              "review_context": { "const": "planning_and_code" },
              "validation_route": { "const": "full" },
              "cleanup_route": { "const": "archive_after_merge" },
              "blocking_reason": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "effective_stage": { "const": "ambiguous" } },
            "required": ["effective_stage"]
          },
          "then": {
            "properties": {
              "decision_source": { "const": "classifier" },
              "review_context": { "const": "classification_only" },
              "validation_route": { "const": "blocked" },
              "cleanup_route": { "const": "blocked" },
              "operator_override": { "type": "null" },
              "blocking_reason": { "type": "string", "minLength": 1 }
            },
            "required": ["blocking_reason"]
          }
        }
      ]
    }
  }
}
