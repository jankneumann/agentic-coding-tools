{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools/openspec/contracts/autopilot/autopilot-run-recovery.schema.json",
  "title": "Autopilot External Run Recovery Envelope",
  "description": "Repository-local recovery state stored outside a disposable feature worktree. It locates and verifies durable loop-state before checkout recreation; it never grants lease ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "change_id",
    "owner",
    "branch",
    "durability_target",
    "durable_head",
    "loop_state_path",
    "loop_state_sha256",
    "resume_phase",
    "lease_id",
    "registry_entry_generation",
    "checkout_state",
    "finalization_intent",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "change_id": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "pattern": "^autopilot:.+" },
    "branch": { "type": "string", "pattern": "^openspec/.+" },
    "durability_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_name", "canonical_remote_url_sha256", "ref_name"],
      "properties": {
        "remote_name": { "type": "string", "minLength": 1 },
        "canonical_remote_url_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ref_name": { "type": "string", "pattern": "^refs/remotes/[^/]+/.+" }
      }
    },
    "durable_head": { "type": ["string", "null"], "minLength": 7 },
    "loop_state_path": { "type": "string", "pattern": "^openspec/changes/[^/]+/loop-state\\.json$" },
    "loop_state_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "resume_phase": { "type": "string", "minLength": 1 },
    "lease_id": { "type": ["string", "null"], "minLength": 1 },
    "registry_entry_generation": { "type": ["string", "null"], "minLength": 1 },
    "checkout_state": { "enum": ["present", "teardown_pending", "removed", "quarantined"] },
    "finalization_intent": { "enum": ["none", "done", "escalate", "exception"] },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "checkout_state": { "enum": ["teardown_pending", "removed"] } },
        "required": ["checkout_state"]
      },
      "then": {
        "properties": {
          "durable_head": { "type": "string", "minLength": 7 },
          "loop_state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "finalization_intent": { "enum": ["done", "escalate", "exception"] }
        }
      }
    }
  ]
}
