{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.local/contracts/vendor-result-envelope.schema.json",
  "title": "VendorResultEnvelope",
  "description": "Versioned result protocol for synchronous and asynchronous vendor commands.",
  "type": "object",
  "required": [
    "version",
    "state"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "state": {
      "enum": [
        "submitted",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "vendor_task_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "submitted",
              "running"
            ]
          }
        }
      },
      "then": {
        "required": [
          "vendor_task_id"
        ],
        "properties": {
          "vendor_task_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "failed",
              "cancelled"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
