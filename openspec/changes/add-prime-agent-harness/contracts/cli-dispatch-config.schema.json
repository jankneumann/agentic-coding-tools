{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/contracts/prime-cli-dispatch-config.schema.json",
  "title": "PrimeCliDispatchConfig",
  "description": "Coordinator-to-dispatcher CLI config contract. Cleanup is optional and argv-only; P7 decides whether prime-local populates it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "dispatch_modes", "model_flag"],
  "properties": {
    "command": {
      "type": "string",
      "const": "prime-agent"
    },
    "dispatch_modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["args"],
        "properties": {
          "args": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "async": {"type": "boolean"}
        }
      }
    },
    "model_flag": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": ["string", "null"]
    },
    "model_fallbacks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "prompt_via_stdin": {
      "type": "boolean"
    },
    "prompt_via_flag": {
      "type": "string",
      "minLength": 1
    },
    "api_key_env": {
      "type": "string",
      "const": "PRIME_API_KEY"
    },
    "cleanup": {
      "$ref": "#/$defs/cleanup"
    }
  },
  "$defs": {
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args"],
      "properties": {
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "default": 10
        }
      }
    }
  }
}

