{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/schemas/adjudication-verdict.schema.json",
  "title": "Orchestrator adjudication verdict set",
  "description": "One verdict per finding selected by the shared adjudication predicate. A verdict states whether a claim is true and what it would cost if true; it never states a gate outcome, which is computed from these verdicts in code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "head_sha", "adjudicator", "verdicts"],
  "properties": {
    "schema_version": {"const": 1},
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The commit the adjudicator read. A verdict set is stale once the head moves."
    },
    "adjudicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor", "family"],
      "properties": {
        "vendor": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "same_family_as_author": {
      "type": "boolean",
      "description": "True when the adjudicator's family authored the change under review. Recorded and surfaced, never disqualifying."
    },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "claim", "impact_if_true", "criticality", "justification"],
        "properties": {
          "finding_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The consensus finding's id."
          },
          "claim": {
            "enum": ["verified", "refuted", "unverifiable"],
            "description": "Whether the finding's claim is true of the code at head_sha."
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line"],
              "properties": {
                "file": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "maxLength": 500}
              }
            },
            "description": "Required and non-empty when claim is verified or refuted; see the allOf below."
          },
          "impact_if_true": {
            "enum": ["blocking", "non_blocking"],
            "description": "What the claim would cost if true, assessed independently of whether it is true."
          },
          "criticality": {
            "enum": ["low", "medium", "high", "critical"],
            "description": "Criticality as the adjudicator calibrates it, which may differ from the reviewer's."
          },
          "justification": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "allOf": [
          {
            "if": {"properties": {"claim": {"enum": ["verified", "refuted"]}}, "required": ["claim"]},
            "then": {"required": ["evidence"], "properties": {"evidence": {"minItems": 1}}}
          }
        ]
      }
    }
  }
}
