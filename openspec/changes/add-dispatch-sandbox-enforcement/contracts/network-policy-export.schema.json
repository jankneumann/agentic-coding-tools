{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.local/contracts/network-policy-export.schema.json",
  "title": "NetworkPolicyExport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "default_action", "rules", "policy_revision", "policy_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "default_action": {"const": "deny"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["destination_kind", "destination_pattern", "port", "action", "priority", "scope", "policy_id"],
        "properties": {
          "destination_kind": {"enum": ["dns", "ipv4", "ipv6"]},
          "destination_pattern": {"type": "string", "minLength": 1},
          "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
          "action": {"enum": ["allow", "deny"]},
          "priority": {"type": "integer"},
          "scope": {"enum": ["agent_profile", "global"]},
          "policy_id": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"destination_kind": {"const": "dns"}}}, "then": {"properties": {"destination_pattern": {"pattern": "^(?:\\*\\.)?(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)*[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"}}}},
          {"if": {"properties": {"destination_kind": {"const": "ipv4"}}}, "then": {"properties": {"destination_pattern": {"pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"}}}},
          {"if": {"properties": {"destination_kind": {"const": "ipv6"}}}, "then": {"properties": {"destination_pattern": {"pattern": "^\\[[0-9A-Fa-f:]+\\]$"}}}}
        ]
      }
    },
    "policy_revision": {"type": "string", "pattern": "^v1:.+:[0-9]+$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
