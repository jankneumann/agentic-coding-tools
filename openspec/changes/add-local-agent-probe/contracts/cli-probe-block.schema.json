{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools/contracts/cli-probe-block.schema.json",
  "title": "agents.yaml cli.probe block",
  "description": "Merged into AGENTS_SCHEMA under agents.*.cli.properties.probe (agent-identity: Declarative CLI Probe Block).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version_args": {"type": "array", "items": {"type": "string", "minLength": 1}, "default": ["--version"]},
    "help_args": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}
    },
    "auth_status_args": {
      "type": "array",
      "minItems": 1,
      "description": "Additionally: the last token must not be \"login\" (enforced in agents_config.validate; not expressible here).",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "(?i)(print-api-key|print-bearer-token|--credentials|--show-token|logout)"}
      }
    },
    "credential_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ignore_flags": {"type": "array", "items": {"type": "string", "pattern": "^-"}}
  }
}
