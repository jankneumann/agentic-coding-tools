{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/schemas/context-impact-handoff.schema.json",
  "title": "Normalized work-package context impact handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_set_version", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "rule_set_version": {"type": "integer", "minimum": 1},
    "packages": {
      "type": "array",
      "items": {"$ref": "#/$defs/package"}
    }
  },
  "$defs": {
    "surface": {
      "type": "string",
      "enum": [
        "capabilities",
        "apis",
        "architecture",
        "decisions",
        "documentation",
        "semantic_code"
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "approved_by", "approved_at"],
      "properties": {
        "rationale": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "disposition", "targets"],
      "properties": {
        "surface": {"$ref": "#/$defs/surface"},
        "disposition": {
          "type": "string",
          "enum": ["refresh", "no-impact", "unknown"]
        },
        "targets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "exception": {"$ref": "#/$defs/exception"}
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "rule_id", "evidence"],
      "properties": {
        "surface": {"$ref": "#/$defs/surface"},
        "rule_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "read_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_allow", "deny", "semantics"],
      "properties": {
        "read_allow": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "semantics": {"const": "read_allow_minus_deny"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "compatibility",
        "declarations",
        "inferred",
        "read_scope"
      ],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "compatibility": {
          "type": "string",
          "enum": ["declared", "legacy-unclassified"]
        },
        "declarations": {
          "type": "array",
          "items": {"$ref": "#/$defs/declaration"}
        },
        "inferred": {
          "type": "array",
          "items": {"$ref": "#/$defs/inference"}
        },
        "read_scope": {"$ref": "#/$defs/read_scope"}
      }
    }
  }
}
