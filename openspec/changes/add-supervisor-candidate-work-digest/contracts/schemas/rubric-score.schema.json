{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-coding-tools.dev/schemas/rubric-score.schema.json",
  "title": "RubricScore",
  "description": "Structured output of the candidate-work rubric sub-agent. One document per batch; digest.py rank validates it and splits it into per-stub cache files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fingerprint", "scored_at", "scores"],
  "$defs": {
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "justification"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "justification": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "stubScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stub_key", "relevance", "value", "readiness", "scope_fit", "risk"],
      "properties": {
        "stub_key": {"type": "string", "pattern": "^(change|prov):.+$"},
        "relevance": {"$ref": "#/$defs/factor"},
        "value": {"$ref": "#/$defs/factor"},
        "readiness": {"$ref": "#/$defs/factor"},
        "scope_fit": {"$ref": "#/$defs/factor"},
        "risk": {"$ref": "#/$defs/factor", "description": "5 = lowest risk, 1 = highest; scored so that higher is always better."},
        "evidence_read": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Repo-relative paths the sub-agent actually read; audit aid."
        }
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "cycle_state.py fingerprint the scores were produced under."},
    "scored_at": {"type": "string", "format": "date-time"},
    "scorer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"vendor": {"type": "string"}, "model": {"type": "string"}, "archetype": {"type": "string"}}
    },
    "scores": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stubScore"}}
  }
}
